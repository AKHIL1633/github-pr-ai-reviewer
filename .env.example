# Copy to .env and fill in. Used by docker-compose.yml and scripts/review_local.py.

# --- Required for any review ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Required for the full GitHub App flow (docker compose) ---
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# Private key on ONE line with literal \n between lines:
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# --- Optional: LangFuse tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Optional tuning ---
# MAX_FINDINGS=25
# PATTERN_SIMILARITY_THRESHOLD=0.2
